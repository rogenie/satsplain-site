---
import { pillars } from '../data/pillars';
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : undefined);
---
<header class="site-header">
  <div class="accent-line" aria-hidden="true"></div>
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-current={current('/')}>Sats<span>plain</span></a>
    <nav class="primary-nav" aria-label="Primary">
      <a href="/start-here/" aria-current={current('/start-here/')}>Start here</a>
      <details class="topics">
        <summary>Topics</summary>
        <ul>
          {pillars.map((pillar) => (
            <li>
              <a href={`/pillars/${pillar.id}/`}>{pillar.title}</a>
            </li>
          ))}
        </ul>
      </details>
      <a href="/glossary/" aria-current={current('/glossary/')}>Glossary</a>
      <a href="/about/" aria-current={current('/about/')}>About</a>
    </nav>
    <a class="header-kit" href="/safety-kit/" aria-current={current('/safety-kit/')}>
      <svg class="header-kit-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" d="M12 3.2 19.2 6.15v5.4c0 4.25-2.9 7.35-7.2 8.85-4.3-1.5-7.2-4.6-7.2-8.85V6.15L12 3.2z"/>
      </svg>
      Safety Kit
    </a>
  </div>
</header>
