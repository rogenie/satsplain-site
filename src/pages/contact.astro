---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildGraph } from '../lib/schema';
import { site } from '../data/site';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact/' },
];
const description = 'Email hello@satsplain.com about a correction, an order, or a refund. We cannot recover stolen crypto or access your account.';
---
<Base title="Contact · Satsplain" description={description} graph={buildGraph({ crumbs })}>
  <Breadcrumbs items={crumbs} />
  <header class="page-header">
    <p class="kicker">Write to us</p>
    <h1>Contact</h1>
    <p class="lede">There is no contact form on this page. Email is how an order, a refund, or a correction reaches us.</p>
  </header>
  <div class="prose">
    <p>Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    <h2 id="orders">Orders and refunds</h2>
    <p>
      For a Safety Kit order or a refund, email <a href={`mailto:${site.email}`}>{site.email}</a> and include the name and email used at checkout.
      The <a href="/refunds/">refund policy</a> says when a refund or a return applies. Do not send a seed phrase.
    </p>
    <h2 id="corrections">Corrections</h2>
    <p>For a correction, include the page URL, the sentence, and a better source. You can also open an issue on <a href={`${site.repo}/issues`}>GitHub</a>. The process is on the <a href="/corrections/">corrections page</a>. GitHub is for corrections, not for orders.</p>
    <p>We cannot recover stolen crypto, trace a wallet, or unlock an exchange account. If you already sent money to a scam, use the reporting steps in <a href="/articles/crypto-scams-to-avoid/">Crypto scams to avoid</a>. Do not send us your seed phrase, passwords, or photos of identification.</p>
    <p>We read messages when we can. This inbox is not a help desk for a financial company, and a reply is not advice about your money.</p>
  </div>
</Base>
