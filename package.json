{
  "name": "satsplain-site",
  "version": "1.0.0",
  "private": true,
  "description": "Satsplain — plain-English crypto education for beginners.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "python3 scripts/generate-og.py && node scripts/generate-llms.mjs && astro build && node scripts/generate-redirects.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check:articles": "node scripts/check-articles.mjs",
    "check:links": "node scripts/check-articles.mjs --dist",
    "og": "python3 scripts/generate-og.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "astro": "^7.4.13",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
