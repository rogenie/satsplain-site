# Optional. Paste only the Google Search Console token (the content value).
# In GitHub Actions, set repository variable PUBLIC_GOOGLE_SITE_VERIFICATION.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. HTTPS endpoint for the Safety Kit waitlist form.
# Leave this empty until a provider is chosen. Do not sign up for a service to fill it in.
# In GitHub Actions, set repository variable PUBLIC_WAITLIST_FORM_ACTION.
# The posted field name is waitlist.emailField in src/data/site.ts (email).
PUBLIC_WAITLIST_FORM_ACTION=
